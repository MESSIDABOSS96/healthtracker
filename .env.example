# Supabase sync (optional — the app runs fully local without these).
# Both are PUBLIC values and ship in the client bundle by design: the anon key
# grants nothing without a session, and every row is gated by RLS on auth.uid().
# The AI provider key is NOT here and never should be — it lives in
# localStorage only, so it can't reach a build, a backup, or a server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
